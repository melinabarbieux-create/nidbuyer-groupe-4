# Copier ce fichier en .env (cp .env.example .env), puis coller votre clé ci-dessous.
# .env est ignoré par git : votre clé ne part jamais sur GitHub.

# ── LLM ───────────────────────────────────────────────────────────────────────
# gemini (clé AI Studio, P1) · vertex (Cloud Run, P2) · ollama (local, P2) · fake (tests hors ligne)
LLM_PROVIDER=gemini
GEMINI_API_KEY=collez-votre-
LLM_MODEL=gemini-3.5-flash-lite
# Gratuit (oct. 2026) : flash-lite = 15 req/min, 500 req/jour ; flash = 5 req/min, 20 req/jour seulement.
# Le secours est essaye automatiquement si LLM_MODEL est sature (503) ou hors quota (429).
LLM_MODEL_SECOURS=gemini-3.1-flash-lite
GOOGLE_CLOUD_PROJECT=nid-mba-2027
GOOGLE_CLOUD_LOCATION=europe-west1
# vertex : `gcloud auth application-default login`, aucune clé à mettre ici.

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PATH=./chroma_db

# ── Base de données annonces (Supabase) ───────────────────────────────────────
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_KEY=eyJ...

# ── Admin (jeton exigé par POST /admin/sync, envoyé par Cloud Scheduler) ─────
ADMIN_TOKEN=changez-moi

# ── Frontend ──────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000

# ── Alertes (optionnel) ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
SLACK_WEBHOOK_URL=
